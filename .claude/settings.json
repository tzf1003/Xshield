{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo deny --locked check*)",
      "Bash(python3 scripts/validate_library.py*)",
      "Bash(python3 scripts/check_env_docs.py*)",
      "Bash(python3 scripts/check_secrets.py*)",
      "Bash(python3 scripts/test_idor_lab.py*)",
      "Bash(scripts/test_postgres.sh*)",
      "Bash(scripts/verify_all.sh*)",
      "Bash(npm ci)",
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(npm run test:e2e*)",
      "Bash(npx playwright test *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./target/xshield-dev/tls/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 120,
            "statusMessage": "Checking git command against repository rules"
          }
        ]
      }
    ]
  }
}
