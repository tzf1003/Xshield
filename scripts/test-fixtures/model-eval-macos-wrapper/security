#!/usr/bin/env bash
set -euo pipefail

if [[ "$*" != 'find-generic-password -s Xshield.Jev.VercelAIGateway -a Xshield -w' ]]; then
    exit 81
fi

case "${XSHIELD_WRAPPER_KEYCHAIN_CASE:-valid}" in
    valid) printf '%s' 'synthetic-gateway-key-for-wrapper-tests' ;;
    empty) ;;
    invalid) printf '%s' 'contains whitespace' ;;
    unavailable) exit 82 ;;
    *) exit 83 ;;
esac
