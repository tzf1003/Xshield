#!/usr/bin/env bash
set -euo pipefail

# The wrapper must build before retrieving the Keychain key.
if [[ "${XSHIELD_WRAPPER_CARGO_CASE:-valid}" == 'unavailable' ]]; then
    exit 90
fi
if [[ ${AI_GATEWAY_API_KEY+x} == x ]]; then
    exit 91
fi
if [[ "$*" != 'build --locked -p xshield-worker --bin xshield-model-eval' ]]; then
    exit 92
fi
if [[ "$PWD" != "${XSHIELD_WRAPPER_EXPECTED_REPO:-}" ]]; then
    exit 93
fi
if [[ "${CARGO_TARGET_DIR:-}" != "$PWD/target" ]]; then
    exit 94
fi
