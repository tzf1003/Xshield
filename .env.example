# Settings of the reference deployment (docker-compose.yml). Copy to `.env` and
# fill in; `.env` is ignored by git and by the image build.

# Database password. Letters and digits only: it is placed in a connection URL.
#   openssl rand -hex 24
XSHIELD_POSTGRES_PASSWORD=

# Secret for session keys and seen-value hashes, and for sealing the model keys saved
# in the console. The gateway and the control plane must share it. Changing it later
# makes the saved model keys unreadable, so they must be saved again (docs/03 3.3.1).
#   openssl rand -hex 32
XSHIELD_CONTEXT_KEY_HEX=

# Administrator password hash, not the password. Keep the single quotes: the
# value contains `$`.
#   docker compose build xshield-control
#   printf '%s\n' 'your password' | docker compose run --rm --no-deps -T xshield-control hash-password
XSHIELD_ADMIN_PASSWORD_HASH=''

# Optional: Jev key for the default AI Gateway route (docs/03 3.3). Uncomment to set it
# here. A key saved on the console's model page takes precedence over it.
#AI_GATEWAY_API_KEY=

# Optional: reverse proxies in front of the console, as addresses or CIDR networks, comma
# separated (docs/03 3.3). Set it only when a proxy appends the client to X-Forwarded-For;
# then failed sign-ins are counted per client and not per proxy. List the proxies, never
# the clients' networks.
#XSHIELD_CONTROL_TRUSTED_PROXIES=10.0.0.1

# Optional: host ports (defaults 8080 for the gateway, 8081 for the console).
#XSHIELD_EDGE_PORT=8080
#XSHIELD_CONTROL_PORT=8081
