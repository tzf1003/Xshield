{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshield.invalid/schemas/audit-event.schema.json",
  "title": "Xshield Audit Event v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "minLength": 3
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "producer_id": {
      "type": "string"
    },
    "producer_boot_id": {
      "type": "string"
    },
    "producer_seq": {
      "type": "integer",
      "minimum": 1
    },
    "request_seq": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_revision": {
      "type": "string"
    },
    "example_only": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "cause_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "RESTRICTED",
        "SYNTHETIC"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "sealed",
            "fixture_unsealed"
          ]
        },
        "previous_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "connection_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "tenant_id",
    "site_id",
    "request_id",
    "trace_id",
    "span_id",
    "producer_id",
    "producer_boot_id",
    "producer_seq",
    "request_seq",
    "occurred_at",
    "observed_at",
    "policy_revision",
    "example_only",
    "evidence_refs",
    "cause_event_ids",
    "payload",
    "sensitivity",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "scoped_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {"pattern": "[^A-Za-z0-9_.-]"}
    },
    "model_artifact_ref": {
      "type": ["string", "null"],
      "maxLength": 45,
      "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_call_id",
        "model_revision",
        "prompt_revision",
        "question_type",
        "status",
        "reason_code",
        "confidence",
        "confidence_status",
        "duration_us",
        "input_artifact_id",
        "output_artifact_id",
        "call_artifact_id"
      ],
      "properties": {
        "model_call_id": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^mdl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "model_revision": {"$ref": "#/$defs/scoped_name"},
        "prompt_revision": {"$ref": "#/$defs/scoped_name"},
        "question_type": {"enum": ["choice", "noul"]},
        "status": {
          "enum": ["started", "requested", "success", "timeout", "error", "cancelled"]
        },
        "reason_code": {"$ref": "#/$defs/scoped_name"},
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_status": {
          "enum": ["provided", "not_applicable", "not_provided", "unavailable"]
        },
        "duration_us": {"type": "integer", "minimum": 0},
        "input_artifact_id": {"$ref": "#/$defs/model_artifact_ref"},
        "output_artifact_id": {"$ref": "#/$defs/model_artifact_ref"},
        "call_artifact_id": {"$ref": "#/$defs/model_artifact_ref"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"confidence_status": {"const": "provided"}},
            "required": ["confidence_status"]
          },
          "then": {"properties": {"confidence": {"type": "number"}}},
          "else": {"properties": {"confidence": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"question_type": {"const": "noul"}},
            "required": ["question_type"]
          },
          "then": {
            "properties": {
              "confidence": {"type": "null"},
              "confidence_status": {"const": "not_applicable"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "success"}},
            "required": ["status"]
          },
          "then": {
            "required": ["output_artifact_id", "call_artifact_id"],
            "properties": {
              "output_artifact_id": {"type": "string"},
              "call_artifact_id": {"type": "string"}
            }
          },
          "else": {"properties": {"confidence": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"status": {"enum": ["requested", "success"]}},
            "required": ["status"]
          },
          "then": {
            "required": ["input_artifact_id"],
            "properties": {"input_artifact_id": {"type": "string"}}
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "stage",
        "stage_execution_id",
        "outcome",
        "reason_code",
        "proof_kind",
        "confidence",
        "confidence_status",
        "duration_us"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "stage_execution_id": {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "outcome": {
          "enum": [
            "PASS",
            "DENY",
            "UNKNOWN",
            "ERROR",
            "SKIPPED",
            "CANCELLED"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "proof_kind": {
          "enum": [
            "deterministic",
            "model",
            "observation",
            "none"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_status": {
          "enum": [
            "provided",
            "not_applicable",
            "not_provided",
            "unavailable"
          ]
        },
        "duration_us": {
          "type": "integer",
          "minimum": 0
        },
        "rule_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^mdl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_revision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "facts": {
          "type": "object"
        },
        "coverage": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"confidence_status": {"const": "provided"}},
            "required": ["confidence_status"]
          },
          "then": {"properties": {"confidence": {"type": "number"}}},
          "else": {"properties": {"confidence": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"proof_kind": {"const": "model"}},
            "required": ["proof_kind"]
          },
          "then": {
            "required": ["model_call_id"],
            "properties": {"model_call_id": {"type": "string"}}
          },
          "else": {
            "properties": {
              "model_call_id": {"type": "null"},
              "model_revision": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "proof_kind": {
                "const": "deterministic"
              }
            },
            "required": [
              "proof_kind"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              },
              "confidence_status": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "SKIPPED",
                  "CANCELLED"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "identity_request_id": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "identity_subject": {
      "$comment": "The Rust boundary additionally enforces a 256-byte UTF-8 limit; JSON Schema maxLength counts Unicode code points.",
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "not": {"pattern": "[\u0000-\u001f\u007f-\u009f]"}
    },
    "identity_counter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "identity_credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "fingerprint"],
        "properties": {
          "kind": {"enum": ["cookie", "bearer", "body_token"]},
          "fingerprint": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "allOf": [
        {
          "contains": {"properties": {"kind": {"const": "cookie"}}, "required": ["kind"]},
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {"properties": {"kind": {"const": "bearer"}}, "required": ["kind"]},
          "minContains": 0,
          "maxContains": 1
        },
        {
          "contains": {"properties": {"kind": {"const": "body_token"}}, "required": ["kind"]},
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "identity_payload": {
      "type": "object",
      "required": ["stage", "outcome", "reason_code", "binding_id", "auth_epoch", "credential_generation"],
      "properties": {
        "stage": {"const": "identity_lifecycle"},
        "outcome": {"const": "PASS"},
        "reason_code": {"$ref": "#/$defs/scoped_name"},
        "binding_id": {
          "type": "string",
          "maxLength": 41,
          "pattern": "^auth_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "auth_epoch": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "credential_generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "identity_session_created": {
      "allOf": [{"$ref": "#/$defs/identity_payload"}],
      "unevaluatedProperties": false,
      "required": ["status"],
      "properties": {
        "reason_code": {"const": "SESSION_CREATED"},
        "status": {"const": "anonymous"},
        "auth_epoch": {"const": 0},
        "credential_generation": {"const": 0}
      }
    },
    "identity_binding_created": {
      "allOf": [{"$ref": "#/$defs/identity_payload"}],
      "unevaluatedProperties": false,
      "required": ["principal_ref", "authorization_context_ref"],
      "properties": {
        "reason_code": {"const": "BINDING_CREATED"},
        "principal_ref": {"$ref": "#/$defs/identity_subject"},
        "authorization_context_ref": {"$ref": "#/$defs/identity_subject"},
        "auth_epoch": {"const": 1},
        "credential_generation": {"const": 1}
      }
    },
    "identity_rotation": {
      "$comment": "The Rust adapter checks exact counter succession and that credential sets and switched contexts actually change.",
      "allOf": [{"$ref": "#/$defs/identity_payload"}],
      "required": ["principal_ref", "authorization_context_ref", "previous_credential_generation", "previous_credentials", "credentials", "rotation_reason"],
      "properties": {
        "principal_ref": {"$ref": "#/$defs/identity_subject"},
        "authorization_context_ref": {"$ref": "#/$defs/identity_subject"},
        "auth_epoch": {"$ref": "#/$defs/identity_counter"},
        "credential_generation": {"$ref": "#/$defs/identity_counter", "minimum": 2},
        "previous_credential_generation": {"$ref": "#/$defs/identity_counter", "maximum": 9223372036854775806},
        "previous_credentials": {"$ref": "#/$defs/identity_credentials"},
        "credentials": {"$ref": "#/$defs/identity_credentials"},
        "rotation_reason": {"enum": ["same_context_refresh", "account_context_changed"]}
      }
    },
    "identity_refreshed": {
      "allOf": [{"$ref": "#/$defs/identity_rotation"}],
      "unevaluatedProperties": false,
      "properties": {
        "reason_code": {"const": "IDENTITY_REFRESHED"},
        "rotation_reason": {"const": "same_context_refresh"}
      }
    },
    "identity_epoch_changed": {
      "allOf": [{"$ref": "#/$defs/identity_rotation"}],
      "unevaluatedProperties": false,
      "required": ["previous_principal_ref", "previous_authorization_context_ref", "previous_auth_epoch"],
      "properties": {
        "reason_code": {"const": "IDENTITY_CONTEXT_CHANGED"},
        "previous_principal_ref": {"$ref": "#/$defs/identity_subject"},
        "previous_authorization_context_ref": {"$ref": "#/$defs/identity_subject"},
        "previous_auth_epoch": {"$ref": "#/$defs/identity_counter", "maximum": 9223372036854775806},
        "auth_epoch": {"minimum": 2},
        "rotation_reason": {"const": "account_context_changed"}
      }
    },
    "evidence_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "outcome", "reason_code", "artifact_id"],
      "properties": {
        "stage": {"const": "evidence_catalog"},
        "outcome": {"const": "PASS"},
        "reason_code": {"const": "EVIDENCE_CATALOG_PUBLISHED"},
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "utc_second": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "response_grant": {
      "$comment": "The Rust publisher additionally compares producer_boot_id with request_id, requires equal 1-based sequence values bounded by candidate_count, compares both UTC timestamps with issued_at_unix, requires a positive lease of at most 86400 seconds, rejects duplicate JSON keys, and binds the event to its outbox row. Batch completeness is not inferred from a single row. These cross-field, byte-level, and source checks are outside JSON Schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "outcome",
        "reason_code",
        "grant_id",
        "binding_id",
        "auth_epoch",
        "response_evidence_id",
        "action_ref",
        "action_id",
        "source_operation_id",
        "operation_id",
        "resource_type",
        "view_profile",
        "mapping_revision",
        "method",
        "route_template",
        "resource_key_hmac",
        "response_body_sha256",
        "fields",
        "response_status",
        "candidate_count",
        "issued_at_unix",
        "expires_at_unix"
      ],
      "properties": {
        "stage": {"const": "response_grant"},
        "outcome": {"const": "PASS"},
        "reason_code": {"const": "GRANT_ISSUED"},
        "grant_id": {
          "type": "string",
          "maxLength": 42,
          "pattern": "^grant_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "binding_id": {
          "type": "string",
          "maxLength": 41,
          "pattern": "^auth_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "auth_epoch": {"$ref": "#/$defs/identity_counter"},
        "response_evidence_id": {
          "type": "string",
          "maxLength": 45,
          "pattern": "^response_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action_ref": {
          "type": "string",
          "maxLength": 71,
          "pattern": "^action\\.[0-9a-f]{64}$"
        },
        "action_id": {"$ref": "#/$defs/scoped_name"},
        "source_operation_id": {"$ref": "#/$defs/scoped_name"},
        "operation_id": {"$ref": "#/$defs/scoped_name"},
        "resource_type": {"$ref": "#/$defs/scoped_name"},
        "view_profile": {"$ref": "#/$defs/scoped_name"},
        "mapping_revision": {"$ref": "#/$defs/scoped_name"},
        "method": {"const": "GET"},
        "route_template": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^/[!-~]*$",
          "not": {"pattern": "[?#]|[^!-~]"}
        },
        "resource_key_hmac": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "response_body_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scoped_name"}
        },
        "response_status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299,
          "not": {"const": 204}
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "issued_at_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "expires_at_unix": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"event_type": {"enum": ["session.created", "binding.created", "identity.refreshed", "epoch.changed"]}},
        "required": ["event_type"]
      },
      "then": {
        "$comment": "This is the gateway identity outbox shape. The publisher separately enforces request/boot equality, row scope/aggregate binding, source isolation and duplicate JSON keys.",
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 39,
            "pattern": "^ev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "tenant_id": {"$ref": "#/$defs/scoped_name"},
          "site_id": {"$ref": "#/$defs/scoped_name"},
          "policy_revision": {"$ref": "#/$defs/scoped_name"},
          "producer_id": {"const": "gateway-identity"},
          "producer_boot_id": {"$ref": "#/$defs/identity_request_id"},
          "request_id": {"$ref": "#/$defs/identity_request_id"},
          "trace_id": {"maxLength": 32},
          "span_id": {"maxLength": 16},
          "producer_seq": {"const": 1},
          "request_seq": {"const": 1},
          "example_only": {"const": false},
          "evidence_refs": {"maxItems": 0},
          "cause_event_ids": {"maxItems": 0},
          "sensitivity": {"const": "SENSITIVE"},
          "integrity": {
            "properties": {
              "state": {"const": "pending"},
              "previous_hash": {"type": "null"},
              "event_hash": {"type": "null"}
            }
          },
          "connection_id": false,
          "agent_run_id": false
        },
        "oneOf": [
          {"properties": {"event_type": {"const": "session.created"}, "payload": {"$ref": "#/$defs/identity_session_created"}}},
          {"properties": {"event_type": {"const": "binding.created"}, "payload": {"$ref": "#/$defs/identity_binding_created"}}},
          {"properties": {"event_type": {"const": "identity.refreshed"}, "payload": {"$ref": "#/$defs/identity_refreshed"}}},
          {"properties": {"event_type": {"const": "epoch.changed"}, "payload": {"$ref": "#/$defs/identity_epoch_changed"}}}
        ]
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "evidence.cataloged"}},
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {"$ref": "#/$defs/evidence_catalog"},
          "producer_id": {"enum": ["gateway-evidence-catalog", "model-eval"]},
          "producer_boot_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "producer_seq": {"const": 1},
          "request_id": {
            "type": "string",
            "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "evidence_refs": {"minItems": 1, "maxItems": 1},
          "cause_event_ids": {"minItems": 1, "maxItems": 1},
          "sensitivity": {"const": "RESTRICTED"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "model.started",
              "model.requested",
              "model.responded",
              "model.failed",
              "model.timeout",
              "model.cancelled"
            ]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {"$ref": "#/$defs/model"},
          "tenant_id": {"$ref": "#/$defs/scoped_name"},
          "site_id": {"$ref": "#/$defs/scoped_name"},
          "policy_revision": {"$ref": "#/$defs/scoped_name"},
          "producer_id": {"$ref": "#/$defs/scoped_name"},
          "request_id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "oneOf": [
          {
            "properties": {
              "event_type": {"const": "model.started"},
              "payload": {"properties": {"status": {"const": "started"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.requested"},
              "payload": {"properties": {"status": {"const": "requested"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.responded"},
              "payload": {"properties": {"status": {"const": "success"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.failed"},
              "payload": {"properties": {"status": {"const": "error"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.timeout"},
              "payload": {"properties": {"status": {"const": "timeout"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.cancelled"},
              "payload": {"properties": {"status": {"const": "cancelled"}}}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "stage.completed",
              "stage.skipped"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"event_type": {"const": "response_grant.issued"}},
        "required": ["event_type"]
      },
      "then": {
        "$comment": "This is the gateway response-grant outbox shape. The schema checks field-local shape only; Rust owns equality, sequence bounds, time arithmetic, duplicate-key rejection, and source/row binding.",
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 39,
            "pattern": "^ev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "tenant_id": {"$ref": "#/$defs/scoped_name"},
          "site_id": {"$ref": "#/$defs/scoped_name"},
          "request_id": {"$ref": "#/$defs/identity_request_id"},
          "producer_id": {"const": "gateway-response-grant"},
          "producer_boot_id": {"$ref": "#/$defs/identity_request_id"},
          "producer_seq": {"type": "integer", "minimum": 1, "maximum": 1000},
          "request_seq": {"type": "integer", "minimum": 1, "maximum": 1000},
          "occurred_at": {"$ref": "#/$defs/utc_second"},
          "observed_at": {"$ref": "#/$defs/utc_second"},
          "policy_revision": {"$ref": "#/$defs/scoped_name"},
          "example_only": {"const": false},
          "evidence_refs": {"maxItems": 0},
          "cause_event_ids": {"maxItems": 0},
          "sensitivity": {"const": "SENSITIVE"},
          "payload": {"$ref": "#/$defs/response_grant"},
          "integrity": {
            "properties": {
              "state": {"const": "pending"},
              "previous_hash": {"type": "null"},
              "event_hash": {"type": "null"}
            }
          },
          "connection_id": false,
          "agent_run_id": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "integrity": {
            "properties": {
              "state": {
                "const": "fixture_unsealed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "example_only": {
            "const": true
          },
          "sensitivity": {
            "const": "SYNTHETIC"
          }
        }
      }
    }
  ]
}
