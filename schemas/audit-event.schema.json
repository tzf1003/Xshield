{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshield.invalid/schemas/audit-event.schema.json",
  "title": "Xshield Audit Event v3",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "event_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_type": {
      "type": "string",
      "minLength": 3
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "span_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "producer_id": {
      "type": "string"
    },
    "producer_boot_id": {
      "type": "string"
    },
    "producer_seq": {
      "type": "integer",
      "minimum": 1
    },
    "request_seq": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_revision": {
      "type": "string"
    },
    "example_only": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "cause_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "uniqueItems": true
    },
    "payload": {
      "type": "object"
    },
    "sensitivity": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "SENSITIVE",
        "RESTRICTED",
        "SYNTHETIC"
      ]
    },
    "integrity": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "pending",
            "sealed",
            "fixture_unsealed"
          ]
        },
        "previous_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "connection_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_run_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "tenant_id",
    "site_id",
    "request_id",
    "trace_id",
    "span_id",
    "producer_id",
    "producer_boot_id",
    "producer_seq",
    "request_seq",
    "occurred_at",
    "observed_at",
    "policy_revision",
    "example_only",
    "evidence_refs",
    "cause_event_ids",
    "payload",
    "sensitivity",
    "integrity"
  ],
  "additionalProperties": false,
  "$defs": {
    "scoped_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {"pattern": "[^A-Za-z0-9_.-]"}
    },
    "model_artifact_ref": {
      "type": ["string", "null"],
      "maxLength": 45,
      "pattern": "^artifact_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_call_id",
        "model_revision",
        "prompt_revision",
        "question_type",
        "status",
        "reason_code",
        "confidence",
        "confidence_status",
        "duration_us"
      ],
      "properties": {
        "model_call_id": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^mdl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "model_revision": {"$ref": "#/$defs/scoped_name"},
        "prompt_revision": {"$ref": "#/$defs/scoped_name"},
        "question_type": {"enum": ["choice", "noul"]},
        "status": {
          "enum": ["started", "requested", "success", "timeout", "error", "cancelled"]
        },
        "reason_code": {"$ref": "#/$defs/scoped_name"},
        "confidence": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_status": {
          "enum": ["provided", "not_applicable", "not_provided", "unavailable"]
        },
        "duration_us": {"type": "integer", "minimum": 0},
        "input_artifact_id": {"$ref": "#/$defs/model_artifact_ref"},
        "output_artifact_id": {"$ref": "#/$defs/model_artifact_ref"},
        "call_artifact_id": {"$ref": "#/$defs/model_artifact_ref"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"confidence_status": {"const": "provided"}},
            "required": ["confidence_status"]
          },
          "then": {"properties": {"confidence": {"type": "number"}}},
          "else": {"properties": {"confidence": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"question_type": {"const": "noul"}},
            "required": ["question_type"]
          },
          "then": {
            "properties": {
              "confidence": {"type": "null"},
              "confidence_status": {"const": "not_applicable"}
            }
          }
        },
        {
          "if": {
            "properties": {"status": {"const": "success"}},
            "required": ["status"]
          },
          "then": {
            "required": ["output_artifact_id", "call_artifact_id"],
            "properties": {
              "output_artifact_id": {"type": "string"},
              "call_artifact_id": {"type": "string"}
            }
          },
          "else": {"properties": {"confidence": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"status": {"enum": ["requested", "success"]}},
            "required": ["status"]
          },
          "then": {
            "required": ["input_artifact_id"],
            "properties": {"input_artifact_id": {"type": "string"}}
          }
        }
      ]
    },
    "stage": {
      "type": "object",
      "required": [
        "stage",
        "stage_execution_id",
        "outcome",
        "reason_code",
        "proof_kind",
        "confidence",
        "confidence_status",
        "duration_us"
      ],
      "properties": {
        "stage": {
          "type": "string"
        },
        "stage_execution_id": {
          "type": "string",
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "outcome": {
          "enum": [
            "PASS",
            "DENY",
            "UNKNOWN",
            "ERROR",
            "SKIPPED",
            "CANCELLED"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "proof_kind": {
          "enum": [
            "deterministic",
            "model",
            "observation",
            "none"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_status": {
          "enum": [
            "provided",
            "not_applicable",
            "not_provided",
            "unavailable"
          ]
        },
        "duration_us": {
          "type": "integer",
          "minimum": 0
        },
        "rule_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_call_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^mdl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_revision": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "facts": {
          "type": "object"
        },
        "coverage": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"confidence_status": {"const": "provided"}},
            "required": ["confidence_status"]
          },
          "then": {"properties": {"confidence": {"type": "number"}}},
          "else": {"properties": {"confidence": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"proof_kind": {"const": "model"}},
            "required": ["proof_kind"]
          },
          "then": {
            "required": ["model_call_id"],
            "properties": {"model_call_id": {"type": "string"}}
          },
          "else": {
            "properties": {
              "model_call_id": {"type": "null"},
              "model_revision": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "proof_kind": {
                "const": "deterministic"
              }
            },
            "required": [
              "proof_kind"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              },
              "confidence_status": {
                "const": "not_applicable"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "SKIPPED",
                  "CANCELLED"
                ]
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "properties": {
              "confidence": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "model.started",
              "model.requested",
              "model.responded",
              "model.failed",
              "model.timeout",
              "model.cancelled"
            ]
          }
        },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {"$ref": "#/$defs/model"},
          "tenant_id": {"$ref": "#/$defs/scoped_name"},
          "site_id": {"$ref": "#/$defs/scoped_name"},
          "policy_revision": {"$ref": "#/$defs/scoped_name"},
          "producer_id": {"$ref": "#/$defs/scoped_name"},
          "request_id": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^req_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "oneOf": [
          {
            "properties": {
              "event_type": {"const": "model.started"},
              "payload": {"properties": {"status": {"const": "started"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.requested"},
              "payload": {"properties": {"status": {"const": "requested"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.responded"},
              "payload": {"properties": {"status": {"const": "success"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.failed"},
              "payload": {"properties": {"status": {"const": "error"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.timeout"},
              "payload": {"properties": {"status": {"const": "timeout"}}}
            }
          },
          {
            "properties": {
              "event_type": {"const": "model.cancelled"},
              "payload": {"properties": {"status": {"const": "cancelled"}}}
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "stage.completed",
              "stage.skipped"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/stage"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "integrity": {
            "properties": {
              "state": {
                "const": "fixture_unsealed"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "example_only": {
            "const": true
          },
          "sensitivity": {
            "const": "SYNTHETIC"
          }
        }
      }
    }
  ]
}
