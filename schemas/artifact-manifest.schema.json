{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshield.invalid/schemas/artifact-manifest.schema.json",
  "title": "Xshield Evidence Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "request_id",
    "tenant_id",
    "site_id",
    "kind",
    "content_type",
    "capture_status",
    "fidelity",
    "bytes_observed",
    "bytes_saved",
    "classification",
    "example_only",
    "storage",
    "integrity",
    "parent_refs",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string"
    },
    "site_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "capture_status": {
      "enum": [
        "complete",
        "partial_limit",
        "partial_cancelled",
        "unavailable",
        "excluded_policy",
        "expired",
        "deleted",
        "corrupt"
      ]
    },
    "fidelity": {
      "enum": [
        "entity_exact",
        "semantic",
        "redacted",
        "unknown"
      ]
    },
    "bytes_observed": {
      "type": "integer",
      "minimum": 0
    },
    "bytes_saved": {
      "type": "integer",
      "minimum": 0
    },
    "classification": {
      "enum": [
        "INTERNAL",
        "SENSITIVE",
        "RESTRICTED",
        "SYNTHETIC"
      ]
    },
    "example_only": {
      "type": "boolean"
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "storage": {
      "type": "object",
      "required": [
        "profile",
        "locator"
      ],
      "properties": {
        "profile": {
          "enum": [
            "aead_envelope_v1",
            "fixture_none"
          ]
        },
        "locator": {
          "type": "string"
        },
        "key_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "type": "object",
      "required": [
        "algorithm",
        "digest"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "sha256_ciphertext",
            "tenant_hmac_plaintext",
            "sha256_fixture"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "storage": {
            "properties": {
              "profile": {
                "const": "fixture_none"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "example_only": {
            "const": true
          },
          "classification": {
            "const": "SYNTHETIC"
          }
        }
      }
    }
  ]
}
