{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xshield.invalid/schemas/model-call.schema.json",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "scoped_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "not": {"pattern": "[^A-Za-z0-9_.-]"}
    }
  },
  "required": [
    "schema_version",
    "model_call_id",
    "request_id",
    "example_only",
    "provider",
    "model_revision",
    "prompt_revision",
    "input_artifact_id",
    "output_artifact_id",
    "question_type",
    "result",
    "probabilities",
    "provider_confidence",
    "confidence_status",
    "probability_semantics",
    "usage",
    "duration_ms",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "model_call_id": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^mdl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "example_only": {
      "type": "boolean"
    },
    "provider": {
      "$ref": "#/$defs/scoped_name"
    },
    "provider_model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)?$"
    },
    "model_revision": {
      "$ref": "#/$defs/scoped_name"
    },
    "prompt_revision": {
      "$ref": "#/$defs/scoped_name"
    },
    "input_artifact_id": {
      "type": "string",
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "output_artifact_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "resolved_model_revision": {
      "anyOf": [
        {"$ref": "#/$defs/scoped_name"},
        {"type": "null"}
      ]
    },
    "reason_code": {
      "$ref": "#/$defs/scoped_name"
    },
    "http_status": {
      "type": ["integer", "null"],
      "minimum": 100,
      "maximum": 999
    },
    "capture_status": {
      "enum": [
        "complete",
        "unavailable",
        "excluded_policy",
        "partial_limit",
        "partial_timeout",
        "partial_transport"
      ]
    },
    "retry_after_seconds": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 86400
    },
    "provider_request_id": {
      "anyOf": [
        {"$ref": "#/$defs/scoped_name"},
        {"type": "null"}
      ]
    },
    "schema_validation": {
      "enum": ["valid", "invalid", "unavailable"]
    },
    "provider_internal": {
      "const": "unavailable"
    },
    "question_type": {
      "enum": [
        "choice",
        "score",
        "noul"
      ]
    },
    "result": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "probabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "provider_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "confidence_status": {
      "enum": [
        "provided",
        "not_applicable",
        "not_provided",
        "unavailable"
      ]
    },
    "probability_semantics": {
      "enum": [
        "provider_reported_uncalibrated",
        "locally_calibrated",
        "synthetic_example"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens",
        "source"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "enum": [
            "provider",
            "estimated",
            "unavailable",
            "synthetic"
          ]
        }
      }
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "success",
        "timeout",
        "error",
        "cancelled",
        "cached"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["success", "cached"]}},
        "required": ["status"]
      },
      "then": {"properties": {"output_artifact_id": {"type": "string"}}}
    },
    {
      "if": {
        "properties": {"status": {"const": "success"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"capture_status": {"const": "complete"}}
      }
    },
    {
      "if": {
        "properties": {"confidence_status": {"const": "provided"}},
        "required": ["confidence_status"]
      },
      "then": {"properties": {"provider_confidence": {"type": "number"}}},
      "else": {"properties": {"provider_confidence": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {
          "question_type": {
            "const": "noul"
          }
        }
      },
      "then": {
        "properties": {
          "provider_confidence": {
            "type": "null"
          },
          "confidence_status": {
            "const": "not_applicable"
          },
          "result": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  ]
}
