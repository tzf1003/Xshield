{
  "cases": [
    {
      "name": "没有规则：逻辑路径就是 URL 路径",
      "routes": [],
      "request": {
        "path": "/rest/basket/6",
        "query": null,
        "content_type": null,
        "headers": [],
        "body": null
      },
      "expect": { "logical_path": "/rest/basket/6", "api": null }
    },
    {
      "name": "请求头来源：两段都取到，请求头名不区分大小写，正文不参与",
      "routes": [
        {
          "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
          "name_from": [["header.X-Service-Id"], ["header.X-Service-Method"]]
        }
      ],
      "request": {
        "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
        "query": null,
        "content_type": "application/json",
        "headers": [
          ["x-service-id", "bus.buriedPointService"],
          ["X-SERVICE-METHOD", "saveBuriedPointList"]
        ],
        "body": "[[{\"a\":1}]]"
      },
      "expect": {
        "logical_path": "/weixin/wx/mp/wx361163d21a65f679/gateway/bus.buriedPointService/saveBuriedPointList",
        "api": {
          "name": "bus.buriedPointService/saveBuriedPointList",
          "from": ["header.X-Service-Id", "header.X-Service-Method"]
        }
      }
    },
    {
      "name": "查询参数来源：源站在查询参数和正文都认，两处一致",
      "routes": [{ "path": "/index.php", "name_from": [["query.action", "body.action"]] }],
      "request": {
        "path": "/index.php",
        "query": "action=doctorList&page=2",
        "content_type": "application/x-www-form-urlencoded",
        "headers": [],
        "body": "action=doctorList"
      },
      "expect": {
        "logical_path": "/index.php/doctorList",
        "api": { "name": "doctorList", "from": ["query.action"] }
      }
    },
    {
      "name": "正文 JSON 字段：读取顶层字段，参数带 charset",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json; charset=utf-8",
        "headers": [],
        "body": "{\"method\":\"user.get\",\"id\":5}"
      },
      "expect": {
        "logical_path": "/api/rpc/user.get",
        "api": { "name": "user.get", "from": ["body.method"] }
      }
    },
    {
      "name": "正文 JSON 字段：a.b.c 逐层读取嵌套字段",
      "routes": [{ "path": "/api/call", "name_from": [["body.op.name"]] }],
      "request": {
        "path": "/api/call",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": "{\"op\":{\"name\":\"list.items\"},\"args\":[1,2]}"
      },
      "expect": {
        "logical_path": "/api/call/list.items",
        "api": { "name": "list.items", "from": ["body.op.name"] }
      }
    },
    {
      "name": "表单正文：按字段名取值",
      "routes": [{ "path": "/form/submit", "name_from": [["body.action"]] }],
      "request": {
        "path": "/form/submit",
        "query": null,
        "content_type": "application/x-www-form-urlencoded",
        "headers": [],
        "body": "module=doctor&action=getById&id=7"
      },
      "expect": {
        "logical_path": "/form/submit/getById",
        "api": { "name": "getById", "from": ["body.action"] }
      }
    },
    {
      "name": "缺失：第二段的请求头没有出现",
      "routes": [
        {
          "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
          "name_from": [["header.X-Service-Id"], ["header.X-Service-Method"]]
        }
      ],
      "request": {
        "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
        "query": null,
        "content_type": "application/json",
        "headers": [["X-Service-Id", "bus.buriedPointService"]],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "missing", "source": "header.X-Service-Method" }
      }
    },
    {
      "name": "重复：同一个请求头出现两次",
      "routes": [
        {
          "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
          "name_from": [["header.X-Service-Id"], ["header.X-Service-Method"]]
        }
      ],
      "request": {
        "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
        "query": null,
        "content_type": null,
        "headers": [
          ["X-Service-Id", "bus.a"],
          ["X-Service-Method", "save"],
          ["X-Service-Method", "delete"]
        ],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "repeated", "source": "header.X-Service-Method" }
      }
    },
    {
      "name": "冲突：源站两处都认的接口名，两处取值不同",
      "routes": [{ "path": "/index.php", "name_from": [["query.action", "body.action"]] }],
      "request": {
        "path": "/index.php",
        "query": "action=getDoctor",
        "content_type": "application/x-www-form-urlencoded",
        "headers": [],
        "body": "action=deleteDoctor"
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "conflict", "source": "body.action" }
      }
    },
    {
      "name": "非法字符：名称含斜杠",
      "routes": [
        {
          "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
          "name_from": [["header.X-Service-Id"], ["header.X-Service-Method"]]
        }
      ],
      "request": {
        "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
        "query": null,
        "content_type": null,
        "headers": [
          ["X-Service-Id", "bus.a"],
          ["X-Service-Method", "save/list"]
        ],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "invalid_name", "source": "header.X-Service-Method" }
      }
    },
    {
      "name": "非法字符：名称超过 64 个字符",
      "routes": [
        {
          "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
          "name_from": [["header.X-Service-Id"], ["header.X-Service-Method"]]
        }
      ],
      "request": {
        "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
        "query": null,
        "content_type": null,
        "headers": [
          ["X-Service-Id", "bus.a"],
          ["X-Service-Method", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"]
        ],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "invalid_name", "source": "header.X-Service-Method" }
      }
    },
    {
      "name": "非法字符：名称为 .. 不作为接口名",
      "routes": [
        {
          "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
          "name_from": [["header.X-Service-Id"], ["header.X-Service-Method"]]
        }
      ],
      "request": {
        "path": "/weixin/wx/mp/wx361163d21a65f679/gateway",
        "query": null,
        "content_type": null,
        "headers": [
          ["X-Service-Id", "bus.a"],
          ["X-Service-Method", ".."]
        ],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "invalid_name", "source": "header.X-Service-Method" }
      }
    },
    {
      "name": "JSON 重复键：字段路径上同一个键出现两次",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": "{\"method\":\"user.get\",\"method\":\"user.delete\"}"
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "repeated", "source": "body.method" }
      }
    },
    {
      "name": "JSON 重复键：不在字段路径上的重复键不影响取值",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": "{\"meta\":{\"a\":1,\"a\":2},\"method\":\"user.get\"}"
      },
      "expect": {
        "logical_path": "/api/rpc/user.get",
        "api": { "name": "user.get", "from": ["body.method"] }
      }
    },
    {
      "name": "正文是数组（批量调用）：字段路径上遇到数组",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": "[{\"method\":\"user.get\"},{\"method\":\"user.delete\"}]"
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "body_unsupported", "source": "body.method" }
      }
    },
    {
      "name": "正文不能解析为 JSON（包括加密的正文）",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": "U2FsdGVkX1+7Rc8s2dX0wQ=="
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "body_not_json", "source": "body.method" }
      }
    },
    {
      "name": "正文类型不是 JSON 或表单",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "text/plain",
        "headers": [],
        "body": "method=user.get"
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "body_unsupported", "source": "body.method" }
      }
    },
    {
      "name": "正文超过解析上限 [body-too-large]",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "body_too_large", "source": "body.method" }
      }
    },
    {
      "name": "没有正文：正文字段缺失",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": null,
        "headers": [],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "missing", "source": "body.method" }
      }
    },
    {
      "name": "正文字段的值是数字：不作为接口名",
      "routes": [{ "path": "/api/rpc", "name_from": [["body.method"]] }],
      "request": {
        "path": "/api/rpc",
        "query": null,
        "content_type": "application/json",
        "headers": [],
        "body": "{\"method\":5}"
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "invalid_name", "source": "body.method" }
      }
    },
    {
      "name": "查询参数：没有查询串时缺失",
      "routes": [{ "path": "/index.php", "name_from": [["query.action"]] }],
      "request": {
        "path": "/index.php",
        "query": null,
        "content_type": null,
        "headers": [],
        "body": null
      },
      "expect": {
        "logical_path": "unknown-api",
        "api": { "unknown": "missing", "source": "query.action" }
      }
    },
    {
      "name": "源站两处都认：正文里没有这个字段时，以查询参数为准",
      "routes": [{ "path": "/index.php", "name_from": [["query.action", "body.action"]] }],
      "request": {
        "path": "/index.php",
        "query": "action=getDoctor",
        "content_type": "application/x-www-form-urlencoded",
        "headers": [],
        "body": "module=doctor"
      },
      "expect": {
        "logical_path": "/index.php/getDoctor",
        "api": { "name": "getDoctor", "from": ["query.action"] }
      }
    },
    {
      "name": "路径以 / 结尾：子路径无法接在接口名前面",
      "routes": [{ "path": "/gw/*", "name_from": [["header.X-Op"]] }],
      "request": {
        "path": "/gw/",
        "query": null,
        "content_type": null,
        "headers": [["X-Op", "getItem"]],
        "body": null
      },
      "expect": { "logical_path": "unknown-api", "api": { "unknown": "route_subpath" } }
    },
    {
      "name": "前缀规则 /x/*：子路径上的请求取得接口名",
      "routes": [{ "path": "/rest/api/*", "name_from": [["header.X-Op"]] }],
      "request": {
        "path": "/rest/api/items/7",
        "query": null,
        "content_type": null,
        "headers": [["X-Op", "getItem"]],
        "body": null
      },
      "expect": {
        "logical_path": "/rest/api/items/7/getItem",
        "api": { "name": "getItem", "from": ["header.X-Op"] }
      }
    },
    {
      "name": "前缀规则 /x/*：不覆盖父路径本身",
      "routes": [{ "path": "/rest/api/*", "name_from": [["header.X-Op"]] }],
      "request": {
        "path": "/rest/api",
        "query": null,
        "content_type": null,
        "headers": [["X-Op", "getItem"]],
        "body": null
      },
      "expect": { "logical_path": "/rest/api", "api": null }
    },
    {
      "name": "精确规则：不覆盖它的子路径",
      "routes": [{ "path": "/rest/api", "name_from": [["header.X-Op"]] }],
      "request": {
        "path": "/rest/api/items",
        "query": null,
        "content_type": null,
        "headers": [["X-Op", "getItem"]],
        "body": null
      },
      "expect": { "logical_path": "/rest/api/items", "api": null }
    },
    {
      "name": "第一条匹配的规则生效",
      "routes": [
        { "path": "/a/b", "name_from": [["header.X-One"]] },
        { "path": "/a/*", "name_from": [["header.X-Two"]] }
      ],
      "request": {
        "path": "/a/b",
        "query": null,
        "content_type": null,
        "headers": [
          ["X-One", "first"],
          ["X-Two", "second"]
        ],
        "body": null
      },
      "expect": {
        "logical_path": "/a/b/first",
        "api": { "name": "first", "from": ["header.X-One"] }
      }
    }
  ]
}
