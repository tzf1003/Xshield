{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "tests/**",
      "vite.config.ts",
      "playwright.config.ts",
      "tsconfig.json",
      "biome.json",
      "!tests/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "error",
        "useIterableCallbackReturn": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "useJsxKeyInIterable": "error",
        "noUnsafeOptionalChaining": "error"
      },
      "a11y": {
        "useButtonType": "error",
        "useAriaPropsSupportedByRole": "error"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  }
}
