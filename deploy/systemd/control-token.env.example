# Copy to /etc/xshield/control-token.env (mode 0640, owner root:xshield).
# This is the bootstrap bearer's validity window, not the token itself (the
# token is XSHIELD_CONTROL_TOKEN_FILE in control.env). Control accepts at
# most a 24-hour window and reads it once at start, so issue a fresh token
# and window, then restart xshield-control.service:
#
#   now=$(date +%s)
#   openssl rand -hex 32 | tee /etc/xshield/secrets/control_token >/dev/null
#   printf 'XSHIELD_CONTROL_TOKEN_ISSUED_AT=%s\n' "$((now - 60))" >/etc/xshield/control-token.env
#   printf 'XSHIELD_CONTROL_TOKEN_EXPIRES_AT=%s\n' "$((now + 86340))" >>/etc/xshield/control-token.env
#   systemctl restart xshield-control.service
#
# Used only for first-time break-glass access; day-to-day operator access is
# through OIDC login.
XSHIELD_CONTROL_TOKEN_ISSUED_AT=0
XSHIELD_CONTROL_TOKEN_EXPIRES_AT=0
