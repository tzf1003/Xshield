# Copy to /etc/xshield/evidence-retain.env (mode 0640, owner root:xshield).
XSHIELD_TENANT_ID=REQUIRED
XSHIELD_SITE_ID=REQUIRED
XSHIELD_EVIDENCE_RETAIN_MAX_PER_CATEGORY=32
XSHIELD_DATABASE_URL_FILE=/etc/xshield/secrets/database_url
XSHIELD_EVIDENCE_ROOT=/var/lib/xshield/evidence
XSHIELD_EVIDENCE_KEY_ID=evidence-r1
XSHIELD_EVIDENCE_KEY_HEX_FILE=/etc/xshield/secrets/evidence_key
# Only when running the one-time orphan sweep variant (docs/26); invalid
# values are refused before any deletion happens.
# XSHIELD_EVIDENCE_ORPHAN_GRACE_SECONDS=86400
