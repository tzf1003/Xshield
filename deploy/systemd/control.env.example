# Copy to /etc/xshield/control.env (mode 0640, owner root:xshield) and fill
# in the values marked REQUIRED. /etc/xshield/control-token.env is a second,
# separate file: it holds the bootstrap bearer issued by an init step (see
# deploy/compose/init.sh for the reference logic) and gets replaced on its
# own schedule without touching this file.

XSHIELD_TENANT_ID=REQUIRED
XSHIELD_SITE_ID=REQUIRED
XSHIELD_CONTROL_LISTEN=127.0.0.1:9443
XSHIELD_CONTROL_OPS_LISTEN=127.0.0.1:9555
XSHIELD_CONTROL_SUBJECT=bootstrap-operator
XSHIELD_CONTROL_ROLES=observer
XSHIELD_CONTROL_TOKEN_FILE=/etc/xshield/secrets/control_token

XSHIELD_CONTROL_OIDC_ISSUER=REQUIRED
XSHIELD_CONTROL_OIDC_CLIENT_ID=REQUIRED
XSHIELD_CONTROL_OIDC_CLIENT_SECRET_FILE=/etc/xshield/secrets/oidc_client_secret
XSHIELD_CONTROL_OIDC_REQUIRED_ACR=REQUIRED
XSHIELD_CONTROL_OIDC_SUBJECT_ROLES_JSON=REQUIRED
XSHIELD_CONTROL_CONSOLE_ORIGIN=REQUIRED

XSHIELD_CONTROL_CURSOR_KEY_HEX_FILE=/etc/xshield/secrets/control_cursor_key
XSHIELD_CONTROL_IDEMPOTENCY_KEY_HEX_FILE=/etc/xshield/secrets/control_idempotency_key
XSHIELD_CONTROL_API_KEY_HASH_KEY_HEX_FILE=/etc/xshield/secrets/control_api_key_hash_key

XSHIELD_CONTROL_AUDIT_KEY_ID=control-audit-r1
XSHIELD_CONTROL_AUDIT_KEY_HEX_FILE=/etc/xshield/secrets/control_journal_key
XSHIELD_CONTROL_AUDIT_MAX_BYTES=268435456
XSHIELD_CONTROL_AUDIT_HIGH_WATERMARK_BYTES=201326592
XSHIELD_CONTROL_AUDIT_SEGMENT_MAX_BYTES=16777216

XSHIELD_JOURNAL_KEY_ID=edge-journal-r1
XSHIELD_JOURNAL_KEY_HEX_FILE=/etc/xshield/secrets/edge_journal_key
XSHIELD_SEAL_KEY_ID=edge-seal-r1
XSHIELD_SEAL_PUBLIC_KEY_HEX_FILE=/etc/xshield/secrets/edge_seal_public_key
XSHIELD_INDEX_TARGET_ID=clickhouse-primary
XSHIELD_AUDIT_MAX_SEGMENT_READ_BYTES=16777216

XSHIELD_DATABASE_URL_FILE=/etc/xshield/secrets/database_url
XSHIELD_CONTROL_DATABASE_MAX_CONNECTIONS=8
XSHIELD_CONTROL_DATABASE_ACQUIRE_TIMEOUT_MS=2000
XSHIELD_CONTROL_REQUESTS_PER_MINUTE=120
XSHIELD_CONTROL_MAX_QUERY_EVENTS=1000
XSHIELD_CONTROL_MAX_QUERY_ARTIFACTS=128
XSHIELD_CONTROL_MAX_OPEN_CASES=32
XSHIELD_CONTROL_MAX_PENDING_EVIDENCE_ACCESS_REQUESTS=32
XSHIELD_CONTROL_MAX_EVIDENCE_ACCESS_TTL_SECONDS=120

XSHIELD_EVIDENCE_ROOT=/var/lib/xshield/evidence
XSHIELD_EVIDENCE_KEY_ID=evidence-r1
XSHIELD_EVIDENCE_KEY_HEX_FILE=/etc/xshield/secrets/evidence_key
XSHIELD_EVIDENCE_MAX_ARTIFACT_BYTES=67108864
XSHIELD_EVIDENCE_MAX_RETENTION_DAYS=30

XSHIELD_EDGE_APPLY_URL=http://127.0.0.1:9553/internal/v1/apply
XSHIELD_EDGE_APPLY_KEY_HEX_FILE=/etc/xshield/secrets/edge_apply_key

XSHIELD_CLICKHOUSE_URL=http://127.0.0.1:8123
XSHIELD_CLICKHOUSE_DATABASE=xshield
XSHIELD_CLICKHOUSE_USER=xshield
XSHIELD_CLICKHOUSE_PASSWORD_FILE=/etc/xshield/secrets/clickhouse_password
XSHIELD_AUDIT_METADATA_RETENTION_DAYS=30

# Private networks your origins live in (docs/19 19.2); empty admits none.
XSHIELD_ALLOWED_UPSTREAM_CIDRS=
