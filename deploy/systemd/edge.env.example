# Copy to /etc/xshield/edge.env (mode 0640, owner root:xshield) and fill in.
# Secret-shaped variables use the `_FILE` convention (docs/19): point them at
# a file under /etc/xshield/secrets/ instead, never set both the plain and
# `_FILE` form of the same variable.

XSHIELD_CONFIG=/etc/xshield/edge.json
XSHIELD_EDGE_OPS_LISTEN=127.0.0.1:9554
XSHIELD_EDGE_APPLY_LISTEN=127.0.0.1:9553
XSHIELD_EDGE_SNAPSHOT_PATH=/var/lib/xshield/edge-snapshot/snapshot.json
XSHIELD_EDGE_APPLY_KEY_HEX_FILE=/etc/xshield/secrets/edge_apply_key
XSHIELD_JOURNAL_KEY_HEX_FILE=/etc/xshield/secrets/edge_journal_key
XSHIELD_DATABASE_URL_FILE=/etc/xshield/secrets/database_url
XSHIELD_FINGERPRINT_KEY_HEX_FILE=/etc/xshield/secrets/fingerprint_key
XSHIELD_SHARE_TOKEN_KEY_HEX_FILE=/etc/xshield/secrets/share_token_key

# Optional native TLS termination (docs/19 19.2). Leave unset for plaintext
# HTTP/1.1, e.g. behind a terminating WAF/CDN (ADR-013).
# XSHIELD_EDGE_TLS_CERT_PATH=/etc/xshield/tls/fullchain.pem
# XSHIELD_EDGE_TLS_KEY_PATH=/etc/xshield/tls/privkey.pem
# XSHIELD_EDGE_TLS_SNI_CERTS=/etc/xshield/tls/sni-map.json

# Optional PROXY protocol v1/v2 from a trusted front door (docs/19 19.2).
# XSHIELD_EDGE_PROXY_PROTOCOL_TRUSTED=10.0.0.1,10.0.0.2

# Only for a loopback-origin lab/dev deployment; never set in production.
# XSHIELD_ALLOW_LOOPBACK_UPSTREAM=1
