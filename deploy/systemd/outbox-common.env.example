# Copy to /etc/xshield/outbox-common.env (mode 0640, owner root:xshield).
# Shared by every xshield-outbox@<family>.service instance; XSHIELD_OUTBOX_FAMILY
# itself is set per-instance by the unit template, not here.
XSHIELD_TENANT_ID=REQUIRED
XSHIELD_SITE_ID=REQUIRED
XSHIELD_DATABASE_URL_FILE=/etc/xshield/secrets/database_url
XSHIELD_OUTBOX_DATABASE_MAX_CONNECTIONS=2
XSHIELD_OUTBOX_DATABASE_ACQUIRE_TIMEOUT_MS=2000
XSHIELD_OUTBOX_MAX_EVENTS=256
XSHIELD_OUTBOX_MAX_BYTES=8388608
XSHIELD_OUTBOX_LEASE_SECONDS=60
XSHIELD_OUTBOX_RETRY_SECONDS=30

XSHIELD_CLICKHOUSE_URL=http://127.0.0.1:8123
XSHIELD_CLICKHOUSE_DATABASE=xshield
XSHIELD_CLICKHOUSE_USER=xshield
XSHIELD_CLICKHOUSE_PASSWORD_FILE=/etc/xshield/secrets/clickhouse_password
XSHIELD_AUDIT_METADATA_RETENTION_DAYS=30
