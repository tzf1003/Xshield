# Evidence retention sweep (docs/26 RB-style runbook). Not wanted by any
# target and ships with no matching .timer: run it on demand with
# `systemctl start xshield-evidence-retain.service` and read the run's
# selected/deleted/failed counts with `journalctl -u xshield-evidence-retain`,
# then repeat per the runbook until every `*_selected` count is 0. Only wire
# up your own timer once you are comfortable with that cadence for this
# deployment — this is a deletion path, not a cache.
[Unit]
Description=Xshield evidence retention sweep (on demand)
Documentation=https://github.com/tzf1003/Xshield/blob/main/docs/26-runbooks.md

[Service]
Type=oneshot
User=xshield
Group=xshield
EnvironmentFile=/etc/xshield/evidence-retain.env
ExecStart=/opt/xshield/current/bin/xshield-evidence-retain ${XSHIELD_TENANT_ID} ${XSHIELD_SITE_ID} ${XSHIELD_EVIDENCE_RETAIN_MAX_PER_CATEGORY}

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/xshield/evidence
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
