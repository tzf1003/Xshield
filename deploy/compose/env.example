# Copy to .env and edit; docker compose reads it for substitution. No secret
# belongs here: init.sh writes those under ./secrets.

# The one tenant and site this deployment serves (control is scoped to it).
XSHIELD_TENANT_ID=tenant_pilot
XSHIELD_SITE_ID=site_pilot

# Images built from the repository Dockerfile (or pulled from your registry).
XSHIELD_IMAGE_PREFIX=xshield-
XSHIELD_IMAGE_TAG=latest

# Management sign-in (docs/19 19.3). The issuer must be HTTPS.
XSHIELD_CONTROL_OIDC_ISSUER=https://idp.example.com/realms/xshield
XSHIELD_CONTROL_OIDC_CLIENT_ID=xshield-console
XSHIELD_CONTROL_OIDC_REQUIRED_ACR=mfa
XSHIELD_CONTROL_OIDC_SUBJECT_ROLES_JSON='[{"subject":"replace-with-idp-subject","roles":["observer"]}]'
XSHIELD_CONTROL_CONSOLE_ORIGIN=https://xshield-admin.example.com
# Roles of the bootstrap bearer init.sh issues (valid for at most 24 hours).
XSHIELD_CONTROL_ROLES=observer

# Edge data listeners: the private address the edge binds and the host ports
# published for your WAF/CDN or load balancer. Site ports must fall in the range.
XSHIELD_SUBNET=172.30.0.0/24
XSHIELD_EDGE_IP=172.30.0.10
XSHIELD_EDGE_PUBLISH_ADDRESS=127.0.0.1
XSHIELD_EDGE_SITE_PORTS=6400-6409
